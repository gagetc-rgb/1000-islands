      "description": "Signature: gateway, flight leg (solid), gateway city, boat leg (dashed), destination; square stops, last one solid.",
      "html": "<ol class=\"ds-route\"><li class=\"ds-stop\"><span>Your gateway</span></li><li class=\"ds-leg\"><span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.5 13.5 21 7.8c.9-.3 1.6.7 1 1.4l-.3.3-6.7 4.6-1.5 6.4c-.2.8-1.3 1-1.7.2l-2-4.3-4.8 1.6-1.5-1.7 3.5-2.6-4.6-.6c-.6-.1-.6-1 0-1.2Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></svg>X h</span></li><li class=\"ds-stop\"><span>Sorong</span></li><li class=\"ds-leg ds-boat\"><span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 16h18l-2.5 4h-13L3 16ZM12 3v13M12 4l6 10h-6M12 6l-5 8h5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></svg>X h</span></li><li class=\"ds-stop\"><span>Raja Ampat</span></li></ol>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-route{list-style:none;margin:0;padding:0 0 28px;display:grid;grid-template-columns:12px 1fr 12px 1fr 12px;font-size:15px;font-variant-numeric:tabular-nums;max-width:520px;color:var(--ink)}.ds-route li{display:grid;grid-template-rows:28px 14px auto}.ds-leg{color:var(--ink-2)}.ds-leg>span{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 8px;white-space:nowrap}.ds-leg::after{content:\"\";grid-row:2;align-self:center;height:2px;background:var(--ink)}.ds-boat::after{height:0;background:none;border-top:2px dashed var(--ink)}.ds-stop{position:relative;width:12px}.ds-stop::before{content:\"\";box-sizing:border-box;grid-row:2;width:12px;height:12px;background:var(--paper);border:2px solid var(--ink)}.ds-stop:last-child::before{background:var(--ink)}.ds-stop span{position:absolute;top:50px;left:50%;transform:translateX(-50%);font-weight:700;white-space:nowrap}.ds-stop:first-child span{left:0;transform:none}.ds-stop:last-child span{left:auto;right:0;transform:none}"
    },
    {
      "name": "Step Line",
      "kind": "custom",
      "refersTo": "",
      "description": "Signature: four process stops on one 2px ink line; no numbers, no circles.",
      "html": "<ol class=\"ds-steps\"><li><h3>Tell us</h3><p>Dates, who is coming.</p></li><li><h3>We design it</h3><p>A private route.</p></li><li><h3>We handle everything</h3><p>Flights, boats, permits.</p></li><li><h3>You travel</h3><p>Our people meet you.</p></li></ol>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);color:var(--ink)}.ds-steps li{position:relative;padding:32px 32px 0 0}.ds-steps li::before{content:\"\";position:absolute;left:0;right:0;top:5px;height:2px;background:var(--ink)}.ds-steps li:last-child::before{right:auto;width:0}.ds-steps li::after{content:\"\";box-sizing:border-box;position:absolute;left:0;top:0;width:12px;height:12px;background:var(--paper);border:2px solid var(--ink)}.ds-steps li:last-child::after{background:var(--ink)}.ds-steps h3{margin:0;font-size:24px;font-weight:750;font-stretch:112%;line-height:1.15;letter-spacing:-.02em}.ds-steps p{margin:8px 0 0;color:var(--ink-2);font-size:16px}"
    },
    {
      "name": "Photo Slot",
      "kind": "card",
      "refersTo": "photo-slot",
      "description": "Labelled placeholder: flat place tone, coordinates top-left, camera caption bottom-left. Square, no border.",
      "html": "<div class=\"ds-slot ds-karst\"><span class=\"ds-coord\">0°14′ S · 130°30′ E</span><span class=\"ds-cap\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 8h3l1.5-2h7L17 8h3v11H4V8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"13.5\" r=\"3.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg>Photo slot · Raja Ampat aerial, karst islets</span></div>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-slot{position:relative;aspect-ratio:5/4;max-width:420px;background:var(--slot-sea);color:var(--on-ink);overflow:hidden}.ds-karst{background:var(--slot-karst)}.ds-coord{position:absolute;left:16px;top:16px;font-size:13px;font-variant-numeric:tabular-nums;letter-spacing:.02em}.ds-cap{position:absolute;left:16px;bottom:16px;display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#dce8ea}"
    },
    {
      "name": "Review Group",
      "kind": "custom",
      "refersTo": "",
      "description": "One lead quote spanning two rows beside two smaller quotes; opens on a 2px ink rule, no boxes.",
      "html": "<div class=\"ds-reviews\"><figure class=\"ds-lead\"><blockquote>Guest review placeholder.</blockquote><figcaption>Name, country</figcaption></figure><figure><blockquote>Guest review placeholder.</blockquote><figcaption>Name, country</figcaption></figure><figure class=\"ds-third\"><blockquote>Guest review placeholder.</blockquote><figcaption>Name, country</figcaption></figure></div>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-reviews{display:grid;grid-template-columns:1.5fr 1fr;gap:48px 64px;border-top:2px solid var(--ink);padding-top:48px;color:var(--ink)}.ds-reviews figure{margin:0}.ds-reviews blockquote{margin:0;font-size:24px;font-weight:600;line-height:1.35;font-stretch:104%}.ds-lead{grid-row:span 2}.ds-lead blockquote{font-size:clamp(28px,2.6vw,36px);font-weight:650;line-height:1.4;letter-spacing:-.01em}.ds-reviews figcaption{margin-top:16px;font-size:15px;color:var(--ink-2)}.ds-third{padding-top:48px;border-top:1px solid var(--rule)}"
    }
  ],
  "narrative": {
    "northStar": "The Passage Plan",
    "overview": "A modern expedition operator, played straight. The page reads like a skipper's passage plan: deep ocean ink bands carry the arrival (hero), the guest story and the footer; content sits on cool white with a pale sea-grey band between; every journey is drawn as one measured line with square stops. Nothing is decorated. Structure comes from heavy, slightly wide type, hairline sea-grey rules and long ink lines, never from boxes.\n\nDensity is calm and generous: sections breathe on a 128px vertical rhythm, two-column asymmetric grids (roughly 1.2 to 1.6 against 1) put a large photo slot beside short copy. Kayak and life-vest yellow appears only where the visitor can act, focus or select, always with ink text on it, so on any screen the yellow is the answer to \"what do I press\".\n\nThe world explicitly rejects the boutique-template look: no serif display, no sand and coral, no rounded cards, no numbered-circle steps, no three equal review boxes.",
    "keyCharacteristics": [
      "Ocean ink fields for hero, story and footer; cool white and a pale sea-grey band for content.",
      "Vest yellow reserved for actions, focus and selection, always with ink text.",
      "One grotesque family (Archivo) on its width axis: heavy and slightly wide for display, plain for body.",
      "Square corners everywhere; hairline rules instead of card boxes.",
      "Journeys and process drawn as measured lines with square stops (route line, step line).",
      "Photo slots are flat place tones with a caption naming the shot; coordinates in tabular figures."
    ],
    "rules": [
      {
        "name": "The Life Vest Rule",
        "body": "Yellow means \"act here\". It is used only for actions, focus and selection, and always carries ocean-ink text. Never yellow headlines, borders, icons, tints or backgrounds of content.",
        "section": "colors"
      },
      {
        "name": "The Two Waters Rule",
        "body": "A surface is either ink (hero, story, footer, header, phone bar) or light (paper, sea-grey band). No third surface colour and no gradients between them; the one gradient in the system is the legibility scrim over the hero photo slot.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Archivo only. Emphasis comes from weight and width (wdth 100 to 115), never from a second family or italics.",
        "section": "typography"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Anything that is a measurement (hours, coordinates, ratings, review counts) uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Flat Water Rule",
        "body": "Content never floats. A shadow is allowed only on an element that genuinely overlays the page (the open menu); everything else separates by tone or a hairline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep vest yellow for actions, focus and selection only, always with ocean-ink text.",
      "Do keep every corner square (0px), including photo slots and stops.",
      "Do separate content with tone bands and hairlines, never boxes.",
      "Do draw sequences (journeys, process) as one measured ink line with 12px square stops, last stop solid.",
      "Do caption every photo slot with the place and the shot until the real photo lands; give it its place tone.",
      "Do keep placeholders (X years, $X,XXX, X h, X.X, XX reviews) visible until the owner confirms the figures.",
      "Do set measurements in tabular figures.",
      "Do keep secondary text at ink-muted on light surfaces and on-ink-muted on ink, at 4.5:1 or better."
    ],
    "donts": [
      "Don't use a serif display face, sand and coral, rounded cards, numbered-circle steps or three equal review boxes.",
      "Don't put yellow on headings, borders, icons, tints or large surfaces.",
      "Don't put a card box (border, fill or shadow) around content blocks.",
      "Don't add shadows to anything that does not genuinely overlay the page.",
      "Don't add a second type family or italics; vary weight and width instead.",
      "Don't add eyebrow or kicker labels above headings; put that information in the heading or the lead."
    ]
  }
}
