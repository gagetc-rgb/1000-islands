    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Vest-yellow action with ink text; the only yellow surface in the system.",
      "html": "<a class=\"ds-btn ds-btn-primary\" href=\"#\">Plan your trip</a>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 24px;border-radius:0;text-decoration:none;font-weight:700;font-size:16px;letter-spacing:.01em;font-family:Archivo,system-ui,sans-serif;transition:background-color .2s,color .2s,border-color .2s}.ds-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ds-btn-primary{background:var(--sun);color:var(--ink)}.ds-btn-primary:hover{background:var(--sun-press)}"
    },
    {
