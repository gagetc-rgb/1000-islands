      "html": "<a class=\"ds-text-link\" href=\"#\">See yacht charters<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-text-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-weight:700;color:var(--ink);text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1.5px}.ds-text-link:focus-visible{outline:3px solid var(--ink);outline-offset:3px}"
    },
    {
      "name": "Site Header",
      "kind": "nav",
      "refersTo": "site-header",
      "description": "Fixed solid ink header: stacked wordmark, plain links, divided trade link, yellow CTA.",
      "html": "<header class=\"ds-header\"><a class=\"ds-logo\" href=\"#\"><b>1000 Islands Travel</b><small>Remote Indonesia</small></a><nav class=\"ds-nav\"><a href=\"#\">Raja Ampat</a><a href=\"#\">North Sulawesi</a><a href=\"#\">Yacht charters</a><a class=\"ds-agents\" href=\"#\">Travel agents</a><a class=\"ds-cta\" href=\"#\">Plan your trip</a></nav></header>",
      "css": ":host{--ink:#0d2229;--ink-2:#44575d;--on-ink:#ffffff;--on-ink-2:#b9c9cd;--paper:#ffffff;--band:#edf2f2;--rule:#c9d5d6;--rule-ink:rgba(255,255,255,.18);--sun:#f5c518;--sun-press:#e2b20c;--slot-sea:#1d3a44;--slot-karst:#2c463f;--slot-volcano:#3a3c3f;--slot-hull:#2f3a4a;font-family:Archivo,system-ui,sans-serif}.ds-header{display:flex;align-items:center;justify-content:space-between;gap:24px;height:76px;padding:0 24px;background:var(--ink);color:var(--on-ink);box-shadow:0 1px 0 var(--rule-ink)}.ds-logo{display:flex;flex-direction:column;line-height:1.1;text-decoration:none;color:inherit}.ds-logo b{font-size:21px;font-weight:800;font-stretch:115%;letter-spacing:-.01em}.ds-logo small{font-size:13px;color:var(--on-ink-2)}.ds-nav{display:flex;gap:24px;align-items:center;font-size:15px;font-weight:600}.ds-nav a{color:inherit;text-decoration:none;padding:12px 0}.ds-nav a:hover{text-decoration:underline;text-underline-offset:4px}.ds-agents{padding-left:24px!important;border-left:1px solid var(--rule-ink)}.ds-nav .ds-cta{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;background:var(--sun);color:var(--ink);font-weight:700}.ds-nav .ds-cta:hover{background:var(--sun-press);text-decoration:none}.ds-nav a:focus-visible,.ds-logo:focus-visible{outline:3px solid var(--sun);outline-offset:3px}"
    },
